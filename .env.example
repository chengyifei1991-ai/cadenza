# ─── HTTP ───────────────────────────────────────────────
# 主 HTTP 监听地址（同时承载 OpAMP / MCP / REST）
HTTP_ADDR=:8080

# ─── 存储 ───────────────────────────────────────────────
# mysql | sqlite
DB_DRIVER=mysql
# MySQL 生产默认（DSN 格式）
DB_DSN=opamp:opamp@tcp(127.0.0.1:3306)/opamp?parseTime=true&charset=utf8mb4
# SQLite 开发回退（DB_DRIVER=sqlite 时生效；纯 Go 驱动，无 CGO）
DB_SQLITE_PATH=./data/opamp.db

# ─── OpAMP ──────────────────────────────────────────────
# Collector 接入认证共享 token（OnConnecting 校验），留空则放行
# /mcp 端点鉴权 token（空=不启用；公网部署必须配置）
MCP_AUTH_TOKEN=
OPAMP_AUTH_TOKEN=

# ─── 配置校验 ───────────────────────────────────────────
# otelcol-contrib 二进制路径（锁定 v0.156.0，随发布包分发）
OTELCOL_BIN=/usr/local/bin/otelcol-contrib
# 深度校验失败是否强制阻断下发（false=仅告警）
STRICT_VALIDATE=false

# ─── LLM（DeepSeek 等 OpenAI 兼容接口）─────────────────
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 备用模型（failover 第二候选，可选）
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
# 本地兜底模型（failover 第三候选，可选，如 Ollama）
LLM_LOCAL_BASE_URL=
LLM_LOCAL_MODEL=

# ─── LLM 稳定性 ─────────────────────────────────────────
LLM_TIMEOUT=60s          # HTTP 客户端总超时
LLM_RETRY=3              # 可重试错误的最大重试次数
LLM_RETRY_BASE=1s        # 指数退避基数（1s/2s/4s...）
LLM_CIRCUIT_THRESHOLD=5  # 连续失败达到该值触发熔断
LLM_CIRCUIT_COOLDOWN=30s # 熔断冷却时长
LLM_CACHE_TTL=10m        # 配置生成结果缓存 TTL

# ─── 审批 ───────────────────────────────────────────────
# 默认是否要求审批（generate/optimize 类任务）
REQUIRE_APPROVAL=true

# ─── Web 控制台（前端阶段 v2 起）─────────────────────────
# 是否内嵌/托管 Web 静态资源（false=纯后端部署，不注册静态路由）
# DISABLE_WEB=false
# 覆盖静态资源目录（可选；默认读取 go:embed 内嵌资源）
# WEB_DIR=

# ─── Web 鉴权（单管理员）─────────────────────────────────
# simple=登录保护（默认，安全默认值）；off=免登（仅本地/演示，风险自负）
# WEB_AUTH_MODE=simple
# 管理员用户名（WEB_AUTH_MODE=simple 时生效）
# WEB_ADMIN_USER=admin
# 管理员口令 bcrypt 哈希（WEB_AUTH_MODE=simple 时必填，缺失将启动失败）
# 生成示例：htpasswd -bnBC 10 "" '你的密码' | tr -d ':\n'
# WEB_ADMIN_PASSWORD_HASH=

# ─── CORS / 探活 ────────────────────────────────────────
# 允许的跨域 Origin（逗号分隔；默认空=同源部署；生产建议保持同源）
# CORS_ALLOWED_ORIGINS=
# 健康检查端点 GET /healthz 常驻开放（无需配置）

# ─── 演示数据 ───────────────────────────────────────────
# true=空库启动时注入演示数据（Collector/任务/审计/会话），用于开箱体验
# DEMO_MODE=false
