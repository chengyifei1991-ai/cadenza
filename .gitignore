# Go build artifacts
/bin/
*.exe
*.test
*.out

# Local module cache & toolchain (workspace-local, not for VCS)
.gocache/
.gopath/

# Local environment (secrets)
.env

# Local database files
*.db
*.db-shm
*.db-wal

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Obsidian（编辑器本地配置，不入库）
.obsidian/
docs/.obsidian/
.build/

# 前端构建产物与依赖
web/node_modules/
web/dist/
# go:embed 静态源由 web/scripts/embed.mjs 填充；仅占位 index.html 入库
internal/webui/static/*
!internal/webui/static/index.html

# 本地包管理缓存（pnpm/npm store 等）
.pnpm-store/
.npm-cache/

# Playwright 产物与浏览器缓存
web/test-results/
web/playwright-report/
web/e2e/test-results/
.pw-browsers/
